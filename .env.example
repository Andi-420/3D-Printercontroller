# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# Die .env wird nicht ins Git-Repo übernommen.

# IP-Adresse des Druckers (Drucker-Display: Einstellungen -> WLAN, oder im Router)
BAMBU_HOST=192.168.1.50

# Seriennummer (Drucker-Display: Einstellungen -> Gerät, oder Bambu Studio -> Gerät)
BAMBU_SERIAL=XXXXXXXXXXXXXXX

# Access Code, 8 Zeichen (Drucker-Display: Einstellungen -> WLAN)
BAMBU_ACCESS_CODE=12345678

# Optional: Web-Oberfläche im ganzen Heimnetz erreichbar machen (z. B. fürs Handy)
# WEB_HOST=0.0.0.0
# WEB_PORT=8080

# Optional: alle Rohnachrichten mitschreiben
# BAMBU_LOG=bambu-log.jsonl
